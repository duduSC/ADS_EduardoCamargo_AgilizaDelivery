# =============================================================================
# Agiliza Delivery — variaveis de ambiente do backend
# =============================================================================
# Copie para ".env" (ignorado pelo git) e preencha os valores.
#   cp .env.example .env
# O compose.yaml le o ".env" sozinho. A aplicacao Spring Boot NAO le: exporte
# as variaveis no shell ou use a configuracao de execucao da IDE (ver README).
#
# NUNCA coloque segredo real neste arquivo (.env.example e versionado).
#
# Atencao: variavel definida VAZIA nao e o mesmo que ausente. O padrao do
# YAML (${X:padrao}) so vale quando a variavel nao existe; definida vazia,
# ela anula o padrao (ex.: JWT_SECRET= vazio impede o perfil h2 de subir).
# Por isso as opcionais e os segredos vem comentados: descomente so o que
# for usar.
# =============================================================================

# -----------------------------------------------------------------------------
# Perfil
# -----------------------------------------------------------------------------
# Perfil do Spring. Opcional. Padrao: h2 (banco em memoria, recriado a cada
# inicio). Valores: h2 | postgres.
# SPRING_PROFILES_ACTIVE=postgres

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL 16)
# -----------------------------------------------------------------------------
# URL JDBC. Obrigatoria no perfil postgres; ignorada no h2. Sem padrao.
# Formato: jdbc:postgresql://<host>:<porta>/<banco>
DB_URL=jdbc:postgresql://localhost:5432/agiliza
# Usuario do banco. Obrigatorio no perfil postgres (sem padrao na aplicacao).
# No compose.yaml, padrao "agiliza".
DB_USER=agiliza
# Senha do banco. Obrigatoria no perfil postgres (sem padrao na aplicacao).
# No compose.yaml ha um padrao so de desenvolvimento; defina a sua.
DB_PASSWORD=troque-me
# Nome do banco criado pelo compose.yaml. Lido SO pelo compose (a aplicacao
# usa DB_URL). Padrao: agiliza. Deve bater com o banco da DB_URL.
DB_NAME=agiliza

# -----------------------------------------------------------------------------
# JWT (D002)
# -----------------------------------------------------------------------------
# Chave HMAC (HS256) em Base64, com ao menos 32 bytes decodificados.
# Obrigatoria no perfil postgres: sem ela a aplicacao nao sobe. No h2 ha um
# padrao so de desenvolvimento. Gerar: openssl rand -base64 48
# JWT_SECRET=troque-me
# Validade do token de acesso. Opcional. Padrao: 3h.
# Formato de duracao do Spring: 30m, 3h, 1d...
# JWT_ACCESS_TTL=3h
# Validade do refresh token. Opcional. Padrao: 30d. (PROVISORIO: refresh
# token fora do DVP 3.1.)
# JWT_REFRESH_TTL=30d

# -----------------------------------------------------------------------------
# Protecao do CPF (AES-256-GCM + HMAC-SHA256)
# -----------------------------------------------------------------------------
# Chave de cifra AES-256 em Base64: exatamente 32 bytes decodificados.
# Obrigatoria no perfil postgres. No h2 ha um padrao so de desenvolvimento.
# Gerar: openssl rand -base64 32
# Trocar a chave torna ilegiveis os CPFs ja gravados.
# AGILIZA_CPF_CHAVE_CIFRA=troque-me
# Chave do HMAC (indice de busca do CPF) em Base64: ao menos 32 bytes
# decodificados. Obrigatoria no perfil postgres. No h2 ha um padrao so de
# desenvolvimento. Gerar: openssl rand -base64 32 (diferente da de cifra).
# AGILIZA_CPF_CHAVE_HASH=troque-me

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Origens do navegador aceitas, separadas por virgula, sem barra no final.
# Opcional. Padrao: vazio (nenhuma origem) no perfil postgres;
# http://localhost:5173 no h2. Nunca use "*" em producao.
# CORS_ORIGENS=http://localhost:5173

# -----------------------------------------------------------------------------
# Google Maps Platform (geocodificacao e rotas)
# -----------------------------------------------------------------------------
# Chave da API. Opcional. Padrao: vazio. Sem ela, a distancia usa o fallback
# Haversine x 1,3 (D009, PROVISORIO) e a geocodificacao nao roda.
# GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Demonstracao e simulador — SO DESENVOLVIMENTO
# -----------------------------------------------------------------------------
# Carga de demonstracao (D009): true | false. Padrao: true no h2, false no
# postgres. Nunca ligue em producao.
# AGILIZA_DEMO=false
# Senha comum dos usuarios de demonstracao (gravada so como hash BCrypt).
# Opcional. Padrao: o do application.yaml (documentado no README).
# AGILIZA_DEMO_SENHA=troque-me
# Worker de integracao com o simulador de pedidos (T011): true | false.
# Padrao: true no h2, false no postgres.
# AGILIZA_WORKER=false
